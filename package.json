{
  "name": "shelfkeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keep track of the books you own — scan, search, shelve. Works offline, stays on your phone.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "idb": "^8.0.3",
    "preact": "^10.29.7",
    "preact-iso": "^2.12.1",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
